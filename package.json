{
  "name": "docs-mcp",
  "version": "0.1.0",
  "description": "Notes by Optiq Labs — MCP server + web app for creating documents with Claude: markdown, Mermaid, Excalidraw, assets, and view-only share links",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/viraj-lakshitha/docs-mcp.git"
  },
  "type": "module",
  "scripts": {
    "build": "npm install --prefix web && npm run build --prefix web",
    "web": "tsx --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local src/web-server.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:db": "node scripts/dev-db.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm run typecheck --prefix web"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vercel/blob": "^2.6.1",
    "csv-parse": "^7.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
