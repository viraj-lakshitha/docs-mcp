{
  "name": "docs-mcp",
  "version": "0.1.0",
  "description": "Notes by Optiq Labs — MCP server + web app for creating documents with Claude: markdown, Mermaid, Excalidraw, assets, and view-only share links",
  "type": "module",
  "scripts": {
    "build": "npm install --prefix web && npm run build --prefix web",
    "web": "node --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local src/web-server.js",
    "dev:web": "npm run dev --prefix web",
    "dev:db": "node scripts/dev-db.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vercel/blob": "^2.6.1",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7"
  }
}
